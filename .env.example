# Application
APP_ENV=development
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL/PostGIS (copy this file to .env and replace the placeholders)
POSTGRES_DB=neighbourhood_score
POSTGRES_USER=replace_with_local_username
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://replace_with_local_username:replace_with_local_password@localhost:5432/neighbourhood_score
